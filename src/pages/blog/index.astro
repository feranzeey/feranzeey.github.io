```astro
---
import Layout from '../../layouts/Layout.astro';

const posts = [
	{
		title: 'Building Reliable Infrastructure with DevOps',
		description:
			'How automation, observability and continuous delivery help teams build systems that are reliable and easier to operate.',
		category: 'DevOps',
		date: 'September 2026',
		link: '/blog/devops-infrastructure',
	},
	{
		title: 'Monitoring Infrastructure with Prometheus and Grafana',
		description:
			'Understanding metrics, dashboards and alerting as part of a practical infrastructure observability strategy.',
		category: 'Observability',
		date: 'Coming soon',
		link: '#',
	},
	{
		title: 'Kubernetes and GitOps in Practice',
		description:
			'Lessons from managing Kubernetes deployments with declarative configuration and Argo CD.',
		category: 'Kubernetes',
		date: 'Coming soon',
		link: '#',
	},
	{
		title: 'Infrastructure as Code with Terraform',
		description:
			'Why infrastructure should be reproducible, version-controlled and managed through code.',
		category: 'Terraform',
		date: 'Coming soon',
		link: '#',
	},
];
---

<Layout
	title="Blog | Feranmi Dada"
	description="Technical writing about DevOps, cloud infrastructure, Kubernetes, Terraform, observability, automation and reliable software delivery."
>
	<main class="blog-page">
		<section class="hero">
			<p class="eyebrow">TECHNICAL BLOG</p>

			<h1>
				Engineering,
				<span>operations &amp; reliability.</span>
			</h1>

			<p class="intro">
				Practical notes from building, automating, monitoring and
				improving infrastructure and software delivery systems.
			</p>
		</section>

		<section class="articles">
			<div class="section-heading">
				<p class="section-label">LATEST ARTICLES</p>
				<h2>Technical writing.</h2>
			</div>

			<div class="post-grid">
				{posts.map((post, index) => (
					<article class="post-card">
						<div class="post-number">
							{String(index + 1).padStart(2, '0')}
						</div>

						<div class="post-meta">
							<span>{post.category}</span>
							<span>{post.date}</span>
						</div>

						<h3>{post.title}</h3>

						<p>{post.description}</p>

						{post.link !== '#' ? (
							<a href={post.link} class="read-more">
								Read article →
							</a>
						) : (
							<span class="coming-soon">
								Coming soon
							</span>
						)}
					</article>
				))}
			</div>
		</section>
	</main>
</Layout>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #080b10;
		color: #e6edf3;
		font-family:
			Inter,
			ui-sans-serif,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
	}

	.blog-page {
		max-width: 1180px;
		margin: 0 auto;
		padding: 100px 32px;
	}

	.hero {
		max-width: 850px;
		padding: 50px 0 110px;
	}

	.eyebrow,
	.section-label {
		color: #7ee787;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 2px;
	}

	h1 {
		margin: 20px 0 30px;
		font-size: clamp(50px, 7vw, 88px);
		line-height: 0.98;
		letter-spacing: -4px;
	}

	h1 span {
		display: block;
		color: #8b949e;
	}

	.intro {
		max-width: 700px;
		color: #9da7b3;
		font-size: 20px;
		line-height: 1.7;
	}

	.articles {
		padding-top: 80px;
		border-top: 1px solid #21262d;
	}

	.section-heading {
		margin-bottom: 40px;
	}

	.section-heading h2 {
		margin: 15px 0 0;
		font-size: clamp(36px, 5vw, 58px);
		letter-spacing: -2px;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
	}

	.post-card {
		padding: 32px;
		border: 1px solid #30363d;
		border-radius: 12px;
		background: #0d1117;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease;
	}

	.post-card:hover {
		transform: translateY(-4px);
		border-color: #7ee787;
	}

	.post-number {
		margin-bottom: 25px;
		color: #7ee787;
		font-family: "Courier New", monospace;
		font-size: 14px;
	}

	.post-meta {
		display: flex;
		justify-content: space-between;
		gap: 15px;
		margin-bottom: 20px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.post-meta span:first-child {
		color: #7ee787;
	}

	.post-meta span:last-child {
		color: #6e7681;
	}

	h3 {
		margin: 0 0 15px;
		font-size: 25px;
		line-height: 1.3;
	}

	.post-card p {
		margin: 0;
		color: #9da7b3;
		line-height: 1.7;
	}

	.read-more {
		display: inline-block;
		margin-top: 25px;
		color: #e6edf3;
		font-weight: 700;
		text-decoration: none;
	}

	.read-more:hover {
		color: #7ee787;
	}

	.coming-soon {
		display: inline-block;
		margin-top: 25px;
		color: #6e7681;
		font-size: 14px;
		font-weight: 700;
	}

	@media (max-width: 800px) {
		.blog-page {
			padding: 70px 20px;
		}

		.hero {
			padding-top: 20px;
			padding-bottom: 80px;
		}

		.post-grid {
			grid-template-columns: 1fr;
		}

		h1 {
			letter-spacing: -2px;
		}
	}
</style>
```
