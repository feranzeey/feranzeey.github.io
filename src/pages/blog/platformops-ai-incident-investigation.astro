---
const title =
	'How I Built AI-Assisted Kubernetes Incident Investigation with PlatformOps AI';

const description =
	'A practical look at how PlatformOps AI combines Kubernetes state, Prometheus metrics and GitHub activity to help engineers investigate infrastructure incidents.';

const date = 'October 2026';

const tags = [
	'Kubernetes',
	'Incident Response',
	'Observability',
	'Prometheus',
	'AI',
	'DevOps',
	'Platform Engineering',
];
