---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		title: 'AI-Powered Incident Response',
		description:
			'An observability and incident-response platform combining Prometheus, Grafana, Loki, Alertmanager and AI-assisted incident analysis.',
		tech: 'Python · Docker · Prometheus · Grafana · Loki',
		link: 'https://github.com/feranzeey/enterprise-anomaly-detection',
	},
	{
		title: 'Infrastructure Health Prediction',
		description:
			'Automated infrastructure monitoring and anomaly detection for predicting resource, network, disk and security issues.',
		tech: 'Python · Docker · Prometheus · Grafana',
		link: 'https://github.com/feranzeey/enterprise-anomaly-detection',
	},
	{
		title: 'Application Performance Intelligence',
		description:
			'Application monitoring and traffic analysis with anomaly detection and scaling recommendations.',
		tech: 'Python · Flask · Prometheus · Locust · ML',
		link: 'https://github.com/feranzeey/enterprise-anomaly-detection',
	},
	{
		title: 'AWS Infrastructure with Terraform',
		description:
			'Reusable cloud infrastructure using Terraform, including VPC networking, subnets, compute and load-balancing components.',
		tech: 'AWS · Terraform · EC2 · VPC',
		link: 'https://github.com/feranzeey',
	},
];
---

<Layout>
	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="hero-content">
				<p class="eyebrow">DEVOPS ENGINEER · CLOUD · AUTOMATION</p>

				<h1>
					Building reliable
					<span>cloud infrastructure</span>
					and automation.
				</h1>

				<p class="intro">
					I am Feranmi Dada, a DevOps Engineer focused on cloud infrastructure,
					CI/CD, Kubernetes, Terraform, observability and automation.
				</p>

				<div class="buttons">
					<a href="#projects" class="button primary">View My Work</a>
					<a
						href="https://github.com/feranzeey"
						target="_blank"
						rel="noopener noreferrer"
						class="button secondary"
					>
						GitHub
					</a>
				</div>
			</div>

			<div class="hero-card">
				<div class="terminal-header">
					<span></span>
					<span></span>
					<span></span>
				</div>

				<div class="terminal-body">
					<p><span class="green">$</span> whoami</p>
					<p class="output">feranmi@devops</p>

					<p><span class="green">$</span> kubectl get infrastructure</p>
					<p class="output success">STATUS: RUNNING</p>

					<p><span class="green">$</span> terraform plan</p>
					<p class="output">Infrastructure as Code ✓</p>

					<p><span class="green">$</span> monitor systems</p>
					<p class="output success">PROMETHEUS + GRAFANA ✓</p>
				</div>
			</div>
		</section>

		<!-- ABOUT -->
		<section class="section" id="about">
			<p class="section-label">01 — ABOUT</p>

			<h2>Turning infrastructure into reliable systems.</h2>

			<p class="section-text">
				I work on building, automating and improving infrastructure that
				helps applications run reliably in production. My work spans cloud
				platforms, infrastructure as code, containerization, CI/CD,
				observability and incident response.
			</p>

			<div class="skills">
				<div>AWS</div>
				<div>Terraform</div>
				<div>Docker</div>
				<div>Kubernetes</div>
				<div>GitHub Actions</div>
				<div>Prometheus</div>
				<div>Grafana</div>
				<div>Python</div>
				<div>Linux</div>
				<div>GitOps</div>
			</div>
		</section>

		<!-- PROJECTS -->
		<section class="section" id="projects">
			<p class="section-label">02 — PROJECTS</p>

			<h2>Things I've built.</h2>

			<div class="projects">
				{projects.map((project, index) => (
					<a
					    href={project.link}
						target="_blank"
						rel="noopener noreferrer"
						class="project-link"
					>
					    <article class="project">
						    <div class="project-number">
							    {String(index + 1).padStart(2, '0')}
							</div>

						<h3>{project.title}</h3>

						<p>{project.description}</p>

						<span class="tech">{project.tech}</span>
						<span class="project-arrow">View project ↗</span>
					</article>
				</a>
				))}
			</div>
		</section>

		<!-- EXPERIENCE -->
		<section class="section" id="experience">
			<p class="section-label">03 — EXPERIENCE</p>

			<h2>DevOps in practice.</h2>

			<div class="experience">
				<div>
					<h3>DevOps Engineer</h3>
					<p class="company">Springer Capital · Remote</p>
				</div>

				<p>
					Working with AWS, Terraform, CI/CD, Kubernetes and infrastructure
					automation while improving development and deployment workflows.
				</p>
			</div>

			<div class="experience">
				<div>
					<h3>DevOps Engineer</h3>
					<p class="company">Oxygen X · Contract</p>
				</div>

				<p>
					Worked on monitoring, system reliability and deployment processes
					to support stable application delivery.
				</p>
			</div>
		</section>

		<!-- CONTACT -->
		<section class="contact" id="contact">
			<p class="section-label">04 — CONTACT</p>

			<h2>Let's build something reliable.</h2>

			<p>
				Interested in DevOps, cloud infrastructure, automation or
				collaboration? Get in touch.
			</p>

			<div class="buttons">
				<a
					href="mailto:dadaferanmi1@gmail.com"
					class="button primary"
				>
					Email Me
				</a>

				<a
					href="https://www.linkedin.com/in/dada-oluwaferanmi-devops"
					target="_blank"
					rel="noopener noreferrer"
					class="button secondary"
				>
					LinkedIn
				</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #080b10;
		color: #e6edf3;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
	}

	main {
		max-width: 1180px;
		margin: auto;
		padding: 0 32px;
	}

	.hero {
		min-height: 85vh;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		align-items: center;
		gap: 70px;
		padding: 80px 0;
	}

	.eyebrow,
	.section-label {
		color: #7ee787;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 2px;
	}

	h1 {
		font-size: clamp(48px, 7vw, 86px);
		line-height: 0.98;
		letter-spacing: -4px;
		margin: 20px 0 30px;
	}

	h1 span {
		display: block;
		color: #8b949e;
	}

	.intro {
		max-width: 650px;
		color: #9da7b3;
		font-size: 20px;
		line-height: 1.7;
	}

	.buttons {
		display: flex;
		gap: 14px;
		margin-top: 35px;
		flex-wrap: wrap;
	}

	.button {
		padding: 13px 22px;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 700;
		border: 1px solid #30363d;
		transition: 0.2s;
	}

	.button.primary {
		background: #7ee787;
		color: #07110a;
		border-color: #7ee787;
	}

	.button.secondary {
		color: #e6edf3;
		background: #11161d;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.hero-card {
		border: 1px solid #30363d;
		border-radius: 14px;
		background: #0d1117;
		box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
		overflow: hidden;
	}

	.terminal-header {
		display: flex;
		gap: 7px;
		padding: 14px 16px;
		border-bottom: 1px solid #21262d;
	}

	.terminal-header span {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #484f58;
	}

	.terminal-body {
		padding: 25px;
		font-family: "Courier New", monospace;
		line-height: 1.7;
		font-size: 14px;
	}

	.green,
	.success {
		color: #7ee787;
	}

	.output {
		color: #8b949e;
		margin: 0 0 15px;
	}

	.section {
		padding: 110px 0;
		border-top: 1px solid #21262d;
	}

	h2 {
		font-size: clamp(36px, 5vw, 58px);
		letter-spacing: -2px;
		margin: 15px 0 25px;
	}

	.section-text {
		max-width: 800px;
		color: #9da7b3;
		font-size: 19px;
		line-height: 1.8;
	}

	.skills {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 35px;
	}

	.skills div {
		padding: 9px 14px;
		border: 1px solid #30363d;
		border-radius: 6px;
		color: #c9d1d9;
		background: #0d1117;
	}

	.projects {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
		margin-top: 45px;
	}
    
	.project-link { 
		colour: inherit;
		text-decoration: none;
		display: block;
	}
	.project {
		height: 100%;
		box-sizing: border-box;
		padding: 30px;
		border: 1px solid #30363d;
		border-radius: 12px;
		background: #0d1117;
		transition: 0.2s;
	}

	.project:hover {
		transform: translateY(-4px);
		border-color: #7ee787;
	}

	.project-number {
		color: #7ee787;
		font-family: monospace;
	}

	.project h3 {
		font-size: 23px;
		margin: 25px 0 12px;
	}

	.project p,
	.experience p,
	.contact p {
		color: #9da7b3;
		line-height: 1.7;
	}

	.tech {
		display: block;
		margin-top: 20px;
		color: #7ee787;
		font-size: 13px;
	}

	.project-arrow {
		display: inline-block;
		margin-top: 25px;
		color: #e6edf3;
		font-size: 14px;
		font-weight: 700;
		transition: 0.2s;
	}
        
	.project-link:hover .project-arrow {
		color: #7ee787;
		transform: translateX(4px);

	.experience {
		display: grid;
		grid-template-columns: 0.7fr 1.3fr;
		gap: 50px;
		padding: 30px 0;
		border-bottom: 1px solid #21262d;
	}

	.experience h3 {
		margin: 0 0 8px;
		font-size: 22px;
	}

	.company {
		margin: 0;
		color: #7ee787 !important;
		font-size: 14px;
	}

	.contact {
		text-align: center;
		padding: 120px 0;
		border-top: 1px solid #21262d;
	}

	.contact p:not(.section-label) {
		max-width: 600px;
		margin: auto;
	}

	.contact .buttons {
		justify-content: center;
	}

	@media (max-width: 800px) {
		main {
			padding: 0 20px;
		}

		.hero {
			grid-template-columns: 1fr;
			gap: 40px;
			padding-top: 50px;
		}

		h1 {
			letter-spacing: -2px;
		}

		.projects {
			grid-template-columns: 1fr;
		}

		.experience {
			grid-template-columns: 1fr;
			gap: 10px;
		}
	}
</style>