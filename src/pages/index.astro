---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		number: '01',
		title: 'AI-Powered Incident Response',
		description:
			'Automated monitoring and incident-response platform that detects infrastructure issues, analyzes logs and metrics, recommends recovery actions, verifies system health, and generates incident reports.',
		tech: 'Python · Flask · FastAPI · Prometheus · Grafana · Loki · Docker',
		link: 'https://github.com/feranzeey/ai-incident-response',
	},
	{
		number: '02',
		title: 'PlatformOps AI',
		description:
			'AI-powered Kubernetes monitoring platform combining infrastructure metrics, observability and GitHub activity to provide actionable operational insights.',
		tech: 'Kubernetes · Prometheus · Grafana · AI · GitHub',
		link: 'https://github.com/feranzeey/platformops-ai',
	},
	{
		number: '03',
		title: 'Infrastructure Health Prediction',
		description:
			'Infrastructure monitoring platform that analyzes system health, detects potential risks, generates health reports, and provides predictive analysis.',
		tech: 'Python · Docker · Prometheus · Grafana · Node Exporter',
		link: 'https://github.com/feranzeey/Infrastructure-Health-Prediction',
	},
	{
		number: '04',
		title: 'Application Performance Intelligence',
		description:
			'AI-driven application monitoring solution designed to identify bottlenecks, detect anomalies, predict traffic, and provide scaling recommendations.',
		tech: 'Python · Flask · Prometheus · Locust · Machine Learning',
		link: 'https://github.com/feranzeey/Application-Performance-Intelligence',
	},
];

const stack = [
	'AWS',
	'Kubernetes',
	'Terraform',
	'Docker',
	'GitHub Actions',
	'Prometheus',
	'Grafana',
	'Linux',
	'Python',
	'GitOps',
];
---

<Layout>
	<main>
		<!-- HERO -->
		<section class="hero">
			<div class="hero-copy">
				<div class="eyebrow">
					<span class="pulse"></span>
					DEVOPS ENGINEER · CLOUD · AUTOMATION
				</div>

				<h1>
					Building
					<span>reliable cloud</span>
					infrastructure.
				</h1>

				<p class="hero-description">
					I am <strong>Feranmi Dada</strong>, a DevOps Engineer focused on
					building reliable cloud infrastructure, automated delivery
					pipelines, observable systems and scalable platforms.
				</p>

				<div class="hero-actions">
					<a href="#projects" class="button button-primary">
						View selected work
						<span>↗</span>
					</a>

					<a
						href="https://github.com/feranzeey"
						target="_blank"
						rel="noopener noreferrer"
						class="button button-secondary"
					>
						GitHub
						<span>↗</span>
					</a>
				</div>

				<div class="availability">
					<span class="availability-dot"></span>
					Open to DevOps & Cloud opportunities
				</div>
			</div>

			<div class="hero-visual">
				<div class="visual-grid"></div>

				<div class="profile-card">
					<div class="profile-top">
						<span>FERANMI DADA</span>
						<span>DEVOPS</span>
					</div>

					<img
						src="/feranmi.jpg"
						alt="Feranmi Dada - DevOps Engineer"
						class="profile-image"
					/>

					<div class="profile-bottom">
						<span>Cloud Infrastructure</span>
						<span class="live">
							<span class="live-dot"></span>
							Available
						</span>
					</div>
				</div>

				<div class="terminal-card">
					<div class="terminal-header">
						<div class="terminal-dots">
							<span></span>
							<span></span>
							<span></span>
						</div>
						<span class="terminal-title">feranmi@devops</span>
					</div>

					<div class="terminal-body">
						<div class="terminal-line">
							<span class="prompt">$</span>
							<span>kubectl get pods</span>
						</div>
						<div class="terminal-output">
							<span class="ok">●</span> production
							<span>Running</span>
						</div>

						<div class="terminal-line">
							<span class="prompt">$</span>
							<span>terraform plan</span>
						</div>
						<div class="terminal-output">
							<span class="ok">✓</span> Infrastructure as Code
						</div>

						<div class="terminal-line">
							<span class="prompt">$</span>
							<span>monitor systems</span>
						</div>
						<div class="terminal-output">
							<span class="ok">✓</span> Prometheus + Grafana
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- STACK -->
		<section class="stack-section">
			<div class="stack-label">TOOLS I WORK WITH</div>

			<div class="stack-list">
				{
					stack.map((item) => (
						<span class="stack-item">
							<span class="stack-marker">+</span>
							{item}
						</span>
					))
				}
			</div>
		</section>

		<!-- ABOUT -->
		<section class="section about-section" id="about">
			<div class="section-heading">
				<span class="section-number">01</span>
				<span class="section-label">ABOUT</span>
			</div>

			<div class="about-grid">
				<h2>
					Infrastructure should be
					<span>reliable by design.</span>
				</h2>

				<div class="about-content">
					<p>
						I build, automate and improve infrastructure that helps
						applications run reliably in production.
					</p>

					<p>
						My work spans cloud platforms, infrastructure as code,
						containerization, CI/CD, Kubernetes, observability and
						incident response.
					</p>

					<a href="#contact" class="text-link">
						Let's work together
						<span>↗</span>
					</a>
				</div>
			</div>
		</section>

		<!-- PROJECTS -->
		<section class="section projects-section" id="projects">
			<div class="section-heading">
				<span class="section-number">02</span>
				<span class="section-label">SELECTED WORK</span>
			</div>

			<div class="section-intro">
				<h2>Systems I have built.</h2>
				<p>
					A selection of infrastructure, automation, observability and
					AI-powered engineering projects.
				</p>
			</div>

			<div class="projects">
				{
					projects.map((project) => (
						<a
							href={project.link}
							target="_blank"
							rel="noopener noreferrer"
							class="project-link"
						>
							<article class="project">
								<div class="project-top">
									<span class="project-number">{project.number}</span>
									<span class="project-arrow">↗</span>
								</div>

								<h3>{project.title}</h3>

								<p>{project.description}</p>

								<div class="project-footer">
									<span>{project.tech}</span>
								</div>
							</article>
						</a>
					))
				}
			</div>
		</section>

		<!-- EXPERIENCE -->
		<section class="section experience-section" id="experience">
			<div class="section-heading">
				<span class="section-number">03</span>
				<span class="section-label">EXPERIENCE</span>
			</div>

			<div class="section-intro">
				<h2>Engineering in practice.</h2>
			</div>

			<div class="experience-list">
				<div class="experience-row">
					<div class="experience-date">2026 — PRESENT</div>

					<div class="experience-main">
						<h3>DevOps Engineer</h3>
						<p class="company">Springer Capital</p>
						<p class="experience-description">
							Working with cloud infrastructure, CI/CD,
							infrastructure automation and modern DevOps practices
							to improve development and deployment workflows.
						</p>
					</div>

					<span class="experience-arrow">↗</span>
				</div>

				<div class="experience-row">
					<div class="experience-date">CONTRACT</div>

					<div class="experience-main">
						<h3>DevOps Engineer</h3>
						<p class="company">Oxygen X</p>
						<p class="experience-description">
							Worked on monitoring, system reliability and deployment
							processes to support stable application delivery.
						</p>
					</div>

					<span class="experience-arrow">↗</span>
				</div>
			</div>
		</section>

		<!-- CONTACT -->
		<section class="contact-section" id="contact">
			<div class="contact-grid">
				<div>
					<div class="section-heading">
						<span class="section-number">04</span>
						<span class="section-label">CONTACT</span>
					</div>

					<h2>
						Let's build
						<span>reliable systems.</span>
					</h2>
				</div>

				<div class="contact-content">
					<p>
						Interested in cloud infrastructure, DevOps, automation or
						collaboration? Get in touch.
					</p>

					<div class="contact-links">
						<a href="mailto:dadaferanmi1@gmail.com">Email me ↗</a>
						<a href="https://www.linkedin.com/in/dada-oluwaferanmi-devops" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
						<a href="https://github.com/feranzeey" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
					</div>
				</div>
			</div>
		</section>

		<!-- FOOTER -->
		<footer>
			<div class="footer-logo">
				FERANMI<span>.</span>
			</div>

			<p>Building reliable systems, one deployment at a time.</p>

			<span>© {new Date().getFullYear()} Feranmi Dada</span>
		</footer>
	</main>
</Layout>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #080b10;
		color: #e6edf3;
		font-family:
			Inter,
			ui-sans-serif,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
	}

	:global(*) {
		box-sizing: border-box;
	}

	main {
		max-width: 1240px;
		margin: auto;
		padding: 0 40px;
	}

	/* HERO */

	.hero {
		min-height: calc(100vh - 76px);
		display: grid;
		grid-template-columns: 1fr 0.9fr;
		align-items: center;
		gap: 70px;
		padding: 70px 0 90px;
	}

	.hero-copy {
		position: relative;
		z-index: 5;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 10px;
		color: #7ee787;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 2px;
	}

	.pulse {
		width: 7px;
		height: 7px;
		background: #7ee787;
		border-radius: 50%;
		box-shadow: 0 0 12px rgba(126, 231, 135, 0.8);
	}

	h1 {
		max-width: 780px;
		margin: 25px 0 28px;
		font-size: clamp(58px, 7vw, 92px);
		line-height: 0.96;
		letter-spacing: -5px;
		font-weight: 800;
	}

	h1 span {
		display: block;
		color: #8b949e;
	}

	.hero-description {
		max-width: 650px;
		margin: 0;
		color: #9da7b3;
		font-size: 18px;
		line-height: 1.75;
	}

	.hero-description strong {
		color: #f0f6fc;
	}

	.hero-actions {
		display: flex;
		gap: 12px;
		margin-top: 32px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: 14px;
		padding: 13px 18px;
		border-radius: 7px;
		text-decoration: none;
		font-size: 14px;
		font-weight: 700;
		transition: 0.2s ease;
	}

	.button span {
		font-size: 16px;
	}

	.button-primary {
		background: #7ee787;
		color: #07110a;
		border: 1px solid #7ee787;
	}

	.button-secondary {
		background: #0d1117;
		color: #e6edf3;
		border: 1px solid #30363d;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.availability {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: 25px;
		color: #6e7681;
		font-size: 12px;
	}

	.availability-dot {
		width: 6px;
		height: 6px;
		background: #7ee787;
		border-radius: 50%;
	}

	/* HERO VISUAL */

	.hero-visual {
		position: relative;
		height: 590px;
	}

	.visual-grid {
		position: absolute;
		inset: 30px -20px 30px 30px;
		background-image:
			linear-gradient(rgba(126, 231, 135, 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(126, 231, 135, 0.045) 1px, transparent 1px);
		background-size: 40px 40px;
		mask-image: linear-gradient(to bottom, transparent, black 20%, black 80%, transparent);
	}

	.profile-card {
		position: absolute;
		top: 25px;
		right: 0px;
		width: 345px;
		padding: 10px;
		background: #0d1117;
		border: 1px solid #30363d;
		border-radius: 16px;
		box-shadow: 0 35px 90px rgba(0, 0, 0, 0.45);
		z-index: 3;
	}

	.profile-top,
	.profile-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 10px 5px;
		color: #6e7681;
		font-family: monospace;
		font-size: 9px;
		letter-spacing: 1px;
	}

	.profile-image {
		display: block;
		width: 100%;
		height: 405px;
		object-fit: cover;
		object-position: center top;
		border-radius: 10px;
	}

	.live {
		display: flex;
		align-items: center;
		gap: 5px;
		color: #7ee787;
	}

	.live-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #7ee787;
	}

	.terminal-card {
		position: absolute;
		left: -35px;
		bottom: 5px;
		width: 300px;
		background: #0d1117;
		border: 1px solid #30363d;
		border-radius: 12px;
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
		overflow: hidden;
		z-index: 1;
	}

	.terminal-header {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 15px;
		border-bottom: 1px solid #21262d;
	}

	.terminal-dots {
		display: flex;
		gap: 6px;
	}

	.terminal-dots span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #484f58;
	}

	.terminal-title {
		color: #6e7681;
		font-family: monospace;
		font-size: 10px;
	}

	.terminal-body {
		padding: 20px;
		font-family: "Courier New", monospace;
		font-size: 11px;
		line-height: 1.7;
	}

	.terminal-line {
		display: flex;
		gap: 9px;
		color: #e6edf3;
		margin-top: 9px;
	}

	.terminal-line:first-child {
		margin-top: 0;
	}

	.prompt,
	.ok {
		color: #7ee787;
	}

	.terminal-output {
		display: flex;
		gap: 8px;
		color: #6e7681;
		margin: 3px 0 13px 17px;
	}

	/* STACK */

	.stack-section {
		display: flex;
		align-items: center;
		gap: 35px;
		padding: 25px 0;
		border-top: 1px solid #21262d;
		border-bottom: 1px solid #21262d;
	}

	.stack-label {
		flex-shrink: 0;
		color: #6e7681;
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 1.5px;
	}

	.stack-list {
		display: flex;
		flex-wrap: wrap;
		gap: 9px 22px;
	}

	.stack-item {
		color: #c9d1d9;
		font-size: 13px;
	}

	.stack-marker {
		color: #7ee787;
		margin-right: 5px;
	}

	/* SECTIONS */

	.section {
		padding: 130px 0;
		border-bottom: 1px solid #21262d;
	}

	.section-heading {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 55px;
	}

	.section-number {
		color: #7ee787;
		font-family: monospace;
		font-size: 12px;
	}

	.section-label {
		color: #6e7681;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 2px;
	}

	.section-intro {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 40px;
		margin-bottom: 45px;
	}

	h2 {
		max-width: 750px;
		margin: 0;
		font-size: clamp(42px, 5vw, 66px);
		line-height: 1;
		letter-spacing: -3px;
	}

	.section-intro p {
		max-width: 360px;
		margin: 0;
		color: #8b949e;
		font-size: 15px;
		line-height: 1.7;
	}

	/* ABOUT */

	.about-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 100px;
	}

	.about-grid h2 span {
		color: #8b949e;
	}

	.about-content {
		padding-top: 5px;
	}

	.about-content p {
		margin: 0 0 20px;
		color: #9da7b3;
		font-size: 17px;
		line-height: 1.8;
	}

	.text-link {
		display: inline-flex;
		gap: 12px;
		margin-top: 15px;
		color: #e6edf3;
		text-decoration: none;
		font-weight: 700;
		font-size: 14px;
		border-bottom: 1px solid #30363d;
		padding-bottom: 7px;
	}

	.text-link:hover {
		color: #7ee787;
		border-color: #7ee787;
	}

	/* PROJECTS */

	.projects {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 14px;
	}

	.project-link {
		color: inherit;
		text-decoration: none;
	}

	.project {
		min-height: 310px;
		padding: 28px;
		background: #0d1117;
		border: 1px solid #21262d;
		border-radius: 10px;
		transition: 0.25s ease;
	}

	.project:hover {
		transform: translateY(-5px);
		border-color: #7ee787;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
	}

	.project-top {
		display: flex;
		justify-content: space-between;
	}

	.project-number {
		color: #7ee787;
		font-family: monospace;
		font-size: 12px;
	}

	.project-arrow {
		color: #6e7681;
		font-size: 18px;
		transition: 0.2s;
	}

	.project:hover .project-arrow {
		color: #7ee787;
		transform: translate(3px, -3px);
	}

	.project h3 {
		margin: 50px 0 14px;
		font-size: 23px;
		letter-spacing: -0.5px;
	}

	.project p {
		margin: 0;
		color: #8b949e;
		font-size: 14px;
		line-height: 1.75;
	}

	.project-footer {
		margin-top: 28px;
		padding-top: 18px;
		border-top: 1px solid #21262d;
	}

	.project-footer span {
		color: #7ee787;
		font-size: 11px;
		line-height: 1.6;
	}

	/* EXPERIENCE */

	.experience-list {
		border-top: 1px solid #21262d;
	}

	.experience-row {
		display: grid;
		grid-template-columns: 170px 1fr 30px;
		gap: 40px;
		padding: 35px 0;
		border-bottom: 1px solid #21262d;
	}

	.experience-date {
		color: #6e7681;
		font-family: monospace;
		font-size: 10px;
		padding-top: 5px;
	}

	.experience-main h3 {
		margin: 0;
		font-size: 23px;
	}

	.company {
		margin: 5px 0 18px;
		color: #7ee787;
		font-size: 13px;
	}

	.experience-description {
		max-width: 650px;
		margin: 0;
		color: #8b949e;
		font-size: 14px;
		line-height: 1.7;
	}

	.experience-arrow {
		color: #6e7681;
		font-size: 18px;
	}

	/* CONTACT */

	.contact-section {
		padding: 140px 0 110px;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 100px;
	}

	.contact-grid h2 span {
		display: block;
		color: #8b949e;
	}

	.contact-content {
		padding-top: 5px;
	}

	.contact-content > p {
		margin: 0;
		color: #9da7b3;
		font-size: 17px;
		line-height: 1.8;
	}

	.contact-links {
		display: flex;
		flex-direction: column;
		margin-top: 35px;
		border-top: 1px solid #21262d;
	}

	.contact-links a {
		display: flex;
		justify-content: space-between;
		padding: 17px 0;
		border-bottom: 1px solid #21262d;
		color: #e6edf3;
		text-decoration: none;
		font-size: 14px;
		font-weight: 700;
	}

	.contact-links a:hover {
		color: #7ee787;
	}

	/* FOOTER */

	footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		padding: 30px 0;
		color: #6e7681;
		font-size: 11px;
	}

	.footer-logo {
		color: #e6edf3;
		font-size: 15px;
		font-weight: 900;
		letter-spacing: -0.5px;
	}

	.footer-logo span {
		color: #7ee787;
	}

	footer p {
		margin: 0;
	}

	/* RESPONSIVE */

	@media (max-width: 950px) {
		main {
			padding: 0 25px;
		}

		.hero {
			grid-template-columns: 1fr;
			min-height: auto;
			padding: 70px 0 90px;
		}

		.hero-visual {
			height: 580px;
			max-width: 600px;
			width: 100%;
			margin: auto;
		}

		.about-grid,
