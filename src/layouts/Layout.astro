---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Feranmi Dada | DevOps Engineer',
	description = 'DevOps Engineer specializing in AWS, Terraform, Kubernetes, Docker, CI/CD, observability and cloud automation.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />

		<title>{title}</title>
	</head>

	<body>
		<header class="site-header">
			<nav class="navbar">
				<a href="/" class="logo">
					FERANMI<span>.</span>
				</a>

				<div class="nav-links">
					<a href="/#about">About</a>
					<a href="/#projects">Projects</a>
					<a href="/#experience">Experience</a>
					<a href="/blog">Blog</a>
					<a href="/#contact">Contact</a>

					<a
						href="https://github.com/feranzeey"
						target="_blank"
						rel="noopener noreferrer"
						class="github-link"
					>
						GitHub ↗
					</a>
				</div>
			</nav>
		</header>

		<slot />
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		width: 100%;
		min-height: 100vh;
		background: #080b10;
		color: #e6edf3;
		font-family:
			Inter,
			ui-sans-serif,
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		background: rgba(8, 11, 16, 0.85);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid #21262d;
	}

	.navbar {
		max-width: 1180px;
		height: 76px;
		margin: 0 auto;
		padding: 0 32px;

		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		color: #e6edf3;
		text-decoration: none;
		font-size: 18px;
		font-weight: 800;
		letter-spacing: 1px;
	}

	.logo span {
		color: #7ee787;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 28px;
	}

	.nav-links a {
		color: #9da7b3;
		text-decoration: none;
		font-size: 14px;
		font-weight: 600;
		transition: color 0.2s ease;
	}

	.nav-links a:hover {
		color: #e6edf3;
	}

	.nav-links .github-link {
		padding: 9px 15px;
		border: 1px solid #30363d;
		border-radius: 7px;
		color: #e6edf3;
		background: #0d1117;
	}

	.nav-links .github-link:hover {
		border-color: #7ee787;
		color: #7ee787;
	}

	@media (max-width: 800px) {
		.navbar {
			height: auto;
			min-height: 70px;
			padding: 16px 20px;
			align-items: flex-start;
		}

		.nav-links {
			gap: 14px;
			flex-wrap: wrap;
			justify-content: flex-end;
		}

		.nav-links a {
			font-size: 12px;
		}

		.nav-links .github-link {
			padding: 7px 10px;
		}
	}

	@media (max-width: 560px) {
		.navbar {
			flex-direction: column;
			gap: 15px;
		}

		.nav-links {
			justify-content: flex-start;
		}
	}
</style>